# strava-mcp configuration template. Copy to .env and fill in your values.
# Get client credentials at https://www.strava.com/settings/api

# --- Strava app credentials ---
# These are the ONLY secrets `.env` holds. Tokens are obtained by `uv run strava-mcp auth`
# and stored solely in the local database — never in `.env`.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- OAuth flow ---
STRAVA_SCOPES=read,read_all,profile:read_all,activity:read,activity:read_all
OAUTH_REDIRECT_HOST=127.0.0.1
OAUTH_REDIRECT_PORT=8721

# --- Local database ---
STRAVA_DB_PATH=./.database/strava.db

# --- Logging & audit ---
# Human-readable log file and its level. Set STRAVA_LOG_LEVEL=DEBUG to see every
# outbound Strava request. An unknown level falls back to INFO.
STRAVA_LOG_PATH=./.logs/strava-mcp.log
STRAVA_LOG_LEVEL=INFO
# Structured (JSONL) audit trail of every MCP tool call, Strava call, and
# dashboard interaction. Rotates beside the human log.
STRAVA_AUDIT_PATH=./.logs/audit.log

# --- MCP HTTP server ---
MCP_HOST=127.0.0.1
MCP_PORT=8720

# --- Sync tuning ---
SYNC_MAX_REQUESTS=900
