# Dokploy / docker-compose environment — the MINIMAL set.
#
# Paste these into Dokploy's Environment settings (it writes them to the .env
# that docker-compose.yml reads via `env_file`). Fill in the two real values.
#
# Everything else the app supports is either:
#   - set by docker-compose.yml (host binds -> 0.0.0.0, DB/log paths -> /data), or
#   - stored in the SQLite DB after `auth` (the OAuth tokens), or
#   - left at its built-in default.
# So it does NOT belong here. See docs/docker.md.

# --- Strava app credentials (the only required secrets) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Optional: raise/lower the per-cycle Strava request budget (default 900) ---
# SYNC_MAX_REQUESTS=900
